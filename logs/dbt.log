    EXEC('
        create view "Sales"."marts_fsales__dbt_tmp__dbt_tmp_vw" as 

with sales_detail as (
    select *
    from "AdventureWorks2019"."Sales"."stg_SalesOrderDetail"
),

sales_header as (
    select *
    from "AdventureWorks2019"."Sales"."stg_SalesOrderHeader"
),

product as (
    select *
    from "AdventureWorks2019"."Sales"."stg_product"
)

select
    sh.sales_order_id,
    sh.order_date,
    pd.product_id,
    pd.name,
    sh.ship_date,
    sum(sd.order_qty) as total_order_qty,
    sum(sd.unit_price * sd.order_qty) as total_sales_amount,
    sh.sub_total,
    sh.taxamt,
    sh.freight,
    sh.total_due,
    sh.order_month,
    sh.order_month_name
from sales_detail sd
join sales_header sh
    on sd.sales_order_id = sh.sales_order_id
join product pd
    on pd.product_id = sd.product_id


where sh.order_date > (select max(order_date) from "BiTest"."Sales"."marts_fsales")


group by
    sh.sales_order_id,
    sh.order_date,
    sh.ship_date,
    sh.sub_total,
    sh.taxamt,
    sh.freight,
    sh.total_due,
    sh.order_month,
    sh.order_month_name,
    pd.product_id,
    pd.name;
    ')

EXEC('
            SELECT * INTO "BiTest"."Sales"."marts_fsales__dbt_tmp" FROM "BiTest"."Sales"."marts_fsales__dbt_tmp__dbt_tmp_vw" 
    OPTION (LABEL = ''dbt-sqlserver'');

        ')

    
